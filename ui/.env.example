# Backend API base URL reachable from the browser (client-side fetches).
# Must be set in any deployment other than local dev.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Backend API base URL reachable from the Next.js server itself (used by
# server-side route handlers, e.g. app/download/[id]/route.ts). Usually the
# same value as NEXT_PUBLIC_API_URL, but can differ if the Next.js server
# reaches the backend over an internal network address that isn't publicly
# routable. Falls back to NEXT_PUBLIC_API_URL if unset.
API_URL=http://localhost:8080

# Public origin of this frontend itself, used to build shareable download
# links and their QR codes (see components/FileCard.tsx).
NEXT_PUBLIC_BASE_URL=http://localhost:3000
